<Window x:Class="Music_Vizualiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Visualizer PRO v2.0" Height="600" Width="1000"
        KeyDown="OnWindowKeyDown" Background="Black"
        SnapsToDevicePixels="False"
        UseLayoutRounding="False"
        RenderOptions.BitmapScalingMode="LowQuality">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="105"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="White" BorderThickness="0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Name="rootGrid">
        <Canvas Name="backgroundContainer" ClipToBounds="True">
            <Image Name="imgBackground" Stretch="UniformToFill" Width="1000" Height="600" RenderTransformOrigin="0.5,0.5">
                <Image.Effect>
                    <BlurEffect x:Name="bgBlur" Radius="0" />
                </Image.Effect>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="bgScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="bgMove" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <Canvas Name="mainCanvas" Background="Transparent" Width="1" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="barsScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="barsMove" X="0" Y="200" />
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>

        <Canvas Name="textCanvas" IsHitTestVisible="True" Background="Transparent" />

        <Image Name="imgLogo" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" 
               Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="logoScale" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>

        <Border Name="panelEscenario" HorizontalAlignment="Right" VerticalAlignment="Stretch" 
                Background="#CC000000" Padding="15" Width="230" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="AUDIO &amp; DISPOSITIVO" Foreground="Lime" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ComboBox Name="cmbAudioDevices" Margin="0,5" SelectionChanged="OnAudioDeviceChanged">
                        <ComboBoxItem Content="Cargando dispositivos..." IsSelected="True"/>
                    </ComboBox>
                    <Button Content="Refrescar Audio" Click="OnRefreshAudioClick" Height="22" FontSize="10" Margin="0,0,0,10"/>

                    <Separator Margin="0,10" Background="#33FFFFFF"/>
                    <TextBlock Text="CONFIG. ESCENARIO" Foreground="Cyan" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <Button Content="Cargar Fondo" Click="OnLoadBackgroundClick" Height="25" Margin="0,0,0,10"/>

                    <TextBlock Text="Desenfoque (Blur)" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldBlur" Minimum="0" Maximum="50" ValueChanged="OnBlurValueChanged"/>

                    <TextBlock Text="Posición X / Y" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldPosX" Minimum="-500" Maximum="500" ValueChanged="OnBackgroundAdjustChanged"/>
                    <Slider Name="sldPosY" Minimum="-500" Maximum="500" ValueChanged="OnBackgroundAdjustChanged"/>

                    <CheckBox Name="chkVinculado" Content="Bloquear Proporción" IsChecked="True" Foreground="White" Margin="0,10" 
                              Checked="OnBackgroundAdjustChanged" Unchecked="OnBackgroundAdjustChanged"/>

                    <TextBlock Text="Zoom / Escala X" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldZoom" Minimum="0.5" Maximum="5" Value="1" ValueChanged="OnBackgroundAdjustChanged"/>

                    <TextBlock Text="Escala Vertical (Y)" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldScaleY" Minimum="0.5" Maximum="5" Value="1" ValueChanged="OnBackgroundAdjustChanged"/>

                    <Separator Margin="0,15" Background="#4400FFFF"/>
                    <CheckBox Name="chkBumpBg" Content="HABILITAR PULSO" Foreground="Cyan" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Text="Sensibilidad Pulso" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldSensBg" Minimum="0" Maximum="10000" Value="2000"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Name="panelVisualizer" HorizontalAlignment="Left" VerticalAlignment="Stretch" 
                Background="#CC001A33" Padding="15" Width="230" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="VISUALIZADOR" Foreground="Yellow" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <CheckBox Name="chkShowFPS" Content="MOSTRAR FPS EN TÍTULO" Foreground="Yellow" 
                              FontSize="10" FontWeight="Bold" Margin="0,0,0,10"
                              Checked="OnFpsCheckboxChanged" Unchecked="OnFpsCheckboxChanged"/>
                    <StackPanel Margin="0,5,0,10">
                        <DockPanel>
                            <TextBlock Text="Límite de FPS:" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtMaxFps" Text="60" Foreground="Cyan" FontWeight="Bold" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </DockPanel>
                        <Slider Name="sldMaxFps" Minimum="15" Maximum="144" Value="60" 
                                TickFrequency="1" IsSnapToTickEnabled="True" 
                                ValueChanged="OnFpsLimitChanged"/>
                    </StackPanel>
                    
                    <CheckBox Name="chkEnableShadows" Content="EFECTOS DE BRILLO (PESADO)" 
                              Foreground="Cyan" FontSize="10" FontWeight="Bold" Margin="0,5,0,10"
                              IsChecked="True" Checked="OnBarStyleChanged" Unchecked="OnBarStyleChanged"/>

                    <TextBlock Text="Modo de Forma" Style="{StaticResource SliderLabel}"/>
                    <ComboBox Name="cmbVisualMode" Margin="0,5,0,15" SelectedIndex="0" SelectionChanged="OnBarsTransformChanged">
                        <ComboBoxItem Content="Barras Lineales"/>
                        <ComboBoxItem Content="Círculo Reactivo"/>
                        <ComboBoxItem Content="Onda Centrada"/>
                    </ComboBox>

                    <TextBlock Text="Posición X / Y" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldBarsX" Minimum="-1000" Maximum="1000" ValueChanged="OnBarsTransformChanged"/>
                    <Slider Name="sldBarsY" Minimum="-600" Maximum="600" Value="200" ValueChanged="OnBarsTransformChanged"/>

                    <TextBlock Text="Escala General" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldBarsScale" Minimum="0.1" Maximum="5" Value="1" ValueChanged="OnBarsTransformChanged"/>

                    <Separator Background="#44FFFFFF" Margin="0,15"/>
                    <TextBlock Text="LOGO" Foreground="White" FontWeight="Bold" Margin="0,5"/>
                    <Button Content="Cargar Logo" Click="OnLoadLogoClick" Margin="0,0,0,5"/>
                    <Slider Name="sldLogoSize" Minimum="50" Maximum="500" Value="150" ValueChanged="OnLogoAdjustChanged"/>

                    <Separator Background="#44FFFFFF" Margin="0,15"/>
                    <TextBlock Text="BARRAS (RGB)" Foreground="Cyan" FontWeight="Bold" Margin="0,5"/>
                    <Slider Name="sldBarR" Minimum="0" Maximum="255" Value="0" ValueChanged="OnBarStyleChanged"/>
                    <Slider Name="sldBarG" Minimum="0" Maximum="255" Value="191" ValueChanged="OnBarStyleChanged"/>
                    <Slider Name="sldBarB" Minimum="0" Maximum="255" Value="255" ValueChanged="OnBarStyleChanged"/>

                    <TextBlock Text="Ancho / Redondeo" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldBarWidth" Minimum="1" Maximum="50" Value="20" ValueChanged="OnBarStyleChanged"/>
                    <Slider Name="sldBarRadius" Minimum="0" Maximum="25" Value="5" ValueChanged="OnBarStyleChanged"/>

                    <TextBlock Text="Sensibilidad Audio" Foreground="Cyan" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldSens" Minimum="1000" Maximum="25000" Value="5000"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Name="panelTextProp" HorizontalAlignment="Right" VerticalAlignment="Stretch" 
                Background="#EE1A1A1A" Padding="15" Width="230" Visibility="Collapsed" Margin="0,0,235,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PROPIEDADES TEXTO" Foreground="Orange" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <Button Content="+ Nuevo Texto" Click="OnAddTextClick" Background="#CC4CAF50" Foreground="White" Height="30" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Name="txtSelectedInfo" Text="Ninguno" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Tamaño Fuente" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldFontSize" Minimum="10" Maximum="200" Value="30" ValueChanged="OnTextPropChanged"/>

                    <TextBlock Text="Color (RGB)" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldColR" Minimum="0" Maximum="255" Value="255" ValueChanged="OnTextPropChanged"/>
                    <Slider Name="sldColG" Minimum="0" Maximum="255" Value="255" ValueChanged="OnTextPropChanged"/>
                    <Slider Name="sldColB" Minimum="0" Maximum="255" Value="255" ValueChanged="OnTextPropChanged"/>

                    <TextBlock Text="Posición X / Y" Style="{StaticResource SliderLabel}"/>
                    <Slider Name="sldTextX" Minimum="0" Maximum="1000" ValueChanged="OnTextPropChanged"/>
                    <Slider Name="sldTextY" Minimum="0" Maximum="600" ValueChanged="OnTextPropChanged" Margin="0,0,0,20"/>

                    <Button Content="Eliminar Texto" Click="OnDeleteTextClick" Background="#CC770000" Foreground="White" Height="30"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Name="menuButtons" VerticalAlignment="Top" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Opacity" Value="0.2"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="120" Height="8" Background="#444444" CornerRadius="0,0,10,10" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Background="#DD000000">
                <Button Content="Escenario" Click="OnToggleEscenarioClick" Style="{StaticResource ModernButtonStyle}" Background="#CC00BCD4"/>
                <Button Content="Visualizador" Click="OnToggleVisualizerClick" Style="{StaticResource ModernButtonStyle}" Background="#CCFFEB3B" Foreground="Black"/>
                <Button Content="Textos" Click="OnToggleTextClick" Style="{StaticResource ModernButtonStyle}" Background="#CCFF9800"/>
                <Separator Width="2" Margin="5,5" Background="White"/>
                <Button Content="Cargar CFG" Click="OnLoadConfigClick" Style="{StaticResource ModernButtonStyle}" Background="#CC3F51B5"/>
                <Button Content="Guardar CFG" Click="OnSaveConfigClick" Style="{StaticResource ModernButtonStyle}" Background="#CC607D8B"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>