<Window x:Class="Music_Vizualiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Visualizer PRO" Height="600" Width="1000"
        KeyDown="Window_KeyDown" Background="Black">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="White" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Name="rootGrid">
        <Canvas Name="backgroundContainer" ClipToBounds="True">
            <Image Name="imgBackground" Stretch="UniformToFill" Width="1000" Height="600" RenderTransformOrigin="0.5,0.5">
                <Image.Effect>
                    <BlurEffect x:Name="bgBlur" Radius="0" />
                </Image.Effect>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="bgScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="bgMove" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Canvas>

        <Canvas Name="mainCanvas" Background="Transparent" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="barsScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="barsMove" X="50" Y="-50" />
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>

        <Canvas Name="textCanvas" IsHitTestVisible="True" Background="Transparent" />

        <Image Name="imgLogo" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" 
               Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="logoScale" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>

        <Border Name="panelAjustes" HorizontalAlignment="Right" VerticalAlignment="Stretch" 
                Background="#CC000000" Padding="15" Width="230" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="CONFIG. ESCENARIO" Foreground="Cyan" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <Button Content="Seleccionar Fondo" Click="BtnLoadBackground_Click" Height="25" Margin="0,0,0,10"/>
                    <TextBlock Text="Desenfoque (Blur)" Foreground="White" FontSize="11"/>
                    <Slider Name="sldBlur" Minimum="0" Maximum="50" ValueChanged="SldBlur_ValueChanged" Margin="0,0,0,10"/>
                    <Separator Margin="0,10" Background="#33FFFFFF"/>
                    <TextBlock Text="Posición Horizontal (X)" Foreground="White" FontSize="11"/>
                    <Slider Name="sldPosX" Minimum="-500" Maximum="500" ValueChanged="BackgroundAdjust_Changed" Margin="0,0,0,5"/>
                    <TextBlock Text="Posición Vertical (Y)" Foreground="White" FontSize="11"/>
                    <Slider Name="sldPosY" Minimum="-500" Maximum="500" ValueChanged="BackgroundAdjust_Changed" Margin="0,0,0,10"/>
                    <CheckBox Name="chkVinculado" Content="Bloquear Proporción" IsChecked="True" Foreground="White" Margin="0,5" 
                              Checked="BackgroundAdjust_Changed" Unchecked="BackgroundAdjust_Changed"/>
                    <TextBlock Text="Zoom / Escala X" Foreground="White" FontSize="11" Margin="0,10,0,0"/>
                    <Slider Name="sldZoom" Minimum="0.5" Maximum="5" Value="1" ValueChanged="BackgroundAdjust_Changed"/>
                    <TextBlock Text="Escala Vertical (Y)" Foreground="White" FontSize="11" Margin="0,5,0,0"/>
                    <Slider Name="sldScaleY" Minimum="0.5" Maximum="5" Value="1" ValueChanged="BackgroundAdjust_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Name="panelBars" HorizontalAlignment="Left" VerticalAlignment="Stretch" 
                Background="#CC001A33" Padding="15" Width="230" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="VISUALIZADOR" Foreground="Yellow" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="Posición X Barras" Foreground="Yellow" FontSize="11"/>
                    <Slider Name="sldBarsX" Minimum="-1000" Maximum="1000" ValueChanged="BarsTransform_Changed" Margin="0,0,0,5"/>
                    <TextBlock Text="Posición Y Barras" Foreground="Yellow" FontSize="11"/>
                    <Slider Name="sldBarsY" Minimum="-600" Maximum="1000" Value="550" ValueChanged="BarsTransform_Changed" Margin="0,0,0,5"/>
                    <TextBlock Text="Tamaño General Barras" Foreground="Yellow" FontSize="11"/>
                    <Slider Name="sldBarsScale" Minimum="0.1" Maximum="3" Value="1" ValueChanged="BarsTransform_Changed" Margin="0,0,0,15"/>
                    <Button Content="Crear Texto (INSERT)" Click="BtnAddText_Click" Background="#FF1E511E" Foreground="White" Height="30" Margin="0,0,0,15"/>
                    <TextBlock Text="Ajuste de Logo" Foreground="White" FontWeight="Bold" Margin="0,5"/>
                    <Button Content="Cargar Logo" Click="BtnLoadLogo_Click" Margin="0,0,0,5"/>
                    <TextBlock Text="Tamaño Logo" Foreground="White" FontSize="11"/>
                    <Slider Name="sldLogoSize" Minimum="50" Maximum="400" Value="150" ValueChanged="LogoAdjust_Changed" Margin="0,0,0,15"/>
                    <TextBlock Text="Diseño de Barras" Foreground="Yellow" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Text="Ancho de Barra" Foreground="White" FontSize="11"/>
                    <Slider Name="sldBarWidth" Minimum="1" Maximum="50" Value="20" ValueChanged="BarStyle_Changed" Margin="0,0,0,5"/>
                    <TextBlock Text="Redondeo" Foreground="White" FontSize="11"/>
                    <Slider Name="sldBarRadius" Minimum="0" Maximum="25" Value="5" ValueChanged="BarStyle_Changed" Margin="0,0,0,15"/>
                    <TextBlock Text="Sensibilidad Audio" Foreground="Cyan" FontWeight="Bold"/>
                    <Slider Name="sldSens" Minimum="1000" Maximum="25000" Value="5000"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Name="panelTextProp" HorizontalAlignment="Right" VerticalAlignment="Stretch" 
                Background="#EE1A1A1A" Padding="15" Width="230" Visibility="Collapsed" Margin="0,0,235,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PROPIEDADES TEXTO" Foreground="Orange" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="Seleccionado:" Foreground="Gray" FontSize="10"/>
                    <TextBlock Name="txtSelectedInfo" Text="Ninguno" Foreground="White" Margin="0,0,0,10" FontWeight="Bold"/>
                    <TextBlock Text="Tamaño de Letra" Foreground="White" FontSize="11"/>
                    <Slider Name="sldFontSize" Minimum="10" Maximum="200" Value="30" ValueChanged="TextProp_Changed" Margin="0,0,0,15"/>
                    <TextBlock Text="COLOR (R - G - B)" Foreground="Orange" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Slider Name="sldColR" Minimum="0" Maximum="255" Value="255" ValueChanged="TextProp_Changed"/>
                    <Slider Name="sldColG" Minimum="0" Maximum="255" Value="255" ValueChanged="TextProp_Changed"/>
                    <Slider Name="sldColB" Minimum="0" Maximum="255" Value="255" ValueChanged="TextProp_Changed" Margin="0,0,0,15"/>
                    <TextBlock Text="Eje X / Eje Y" Foreground="Orange" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Slider Name="sldTextX" Minimum="0" Maximum="1000" ValueChanged="TextProp_Changed"/>
                    <Slider Name="sldTextY" Minimum="0" Maximum="600" ValueChanged="TextProp_Changed" Margin="0,0,0,20"/>
                    <Button Content="Eliminar Texto" Click="BtnDeleteText_Click" Background="#CC770000" Foreground="White" Height="30"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Name="menuButtons" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Opacity" Value="0.05"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Width="80" Height="10" Background="#444444" CornerRadius="0,0,8,8" HorizontalAlignment="Center" Margin="0,0,0,5">
                <Rectangle Width="30" Height="2" Fill="#888888" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Background="#AA000000">
                <Button Content="Escenario" Click="BtnToggleEscenario_Click" Style="{StaticResource ModernButtonStyle}" Background="#CC00BCD4"/>
                <Button Content="Visualizador" Click="BtnToggleBars_Click" Style="{StaticResource ModernButtonStyle}" Background="#CCFFEB3B" Foreground="Black"/>
                <Button Content="Texto" Click="BtnToggleText_Click" Style="{StaticResource ModernButtonStyle}" Background="#CCFF9800"/>
                <Button Content="+ Texto" Click="BtnAddText_Click" Style="{StaticResource ModernButtonStyle}" Background="#CC4CAF50"/>

                <Separator Width="2" Margin="5,5" Background="White"/>
                <Button Content="Cargar CFG" Click="BtnLoadConfig_Click" Style="{StaticResource ModernButtonStyle}" Background="#CC3F51B5"/>
                <Button Content="Guardar CFG" Click="BtnSaveConfig_Click" Style="{StaticResource ModernButtonStyle}" Background="#CC607D8B"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>